# Easy-Web 环境变量配置
# 复制为 .env 后填写，.env 不会提交到 Git

# ---------- LLM（OpenAI 兼容接口）----------
# API Key（必填，启用真实 LLM 时）
LLM_API_KEY=

# 服务地址（DeepSeek / Ollama / vLLM 等可改此项）
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# 是否启用 LLM（true/false，覆盖 settings.yaml）
LLM_ENABLED=false

# Mock 模式，不调真实 API（true/false）
LLM_MOCK=false

# 可选参数
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096

# ---------- 钉钉通知（可选）----------
DINGTALK_WEBHOOK=

# ---------- 运行路径覆盖（可选，优先级高于 settings.yaml）----------
# 不使用内置 pkg 时，可通过环境变量指向自备浏览器/驱动/网站
# EASYWEB_BROWSER_PATH=C:\tools\chrome.exe
# EASYWEB_DRIVER_PATH=C:\tools\chromedriver.exe
# EASYWEB_WEBSITE_PATH=C:\tools\UITestWebsite.exe
# EASYWEB_BASE_URL=https://www.example.com
# EASYWEB_HEADLESS=true
