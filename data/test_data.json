[
    {
        "id": "TC001",
        "name": "首页搜索-(CSS选择器)",
        "type": "search",
        "url": "${base_url}/",
        "selector": "#search-input",
        "value": "selenium",
        "expected_type": "title",
        "expected_value": "搜索",
        "priority": "P0",
        "description": "【业务】验证首页搜索功能 | 【技术】演示 CSS 选择器定位输入框并执行搜索"
    },
    {
        "id": "TC002",
        "name": "管理员登录-(ID定位)",
        "type": "login",
        "url": "${base_url}/login",
        "selector": "#username,#password,#login-btn",
        "value": "admin,123456",
        "result_selector": ".welcome",
        "expected_type": "text",
        "expected_value": "admin",
        "priority": "P0",
        "description": "【业务】验证管理员成功登录跳转 | 【技术】演示 ID 定位多元素组合操作"
    },
    {
