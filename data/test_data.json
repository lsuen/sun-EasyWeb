    {
        "id": "WF001",
        "name": "工作流-完整登录流程",
        "type": "workflow",
        "url": "${base_url}/",
        "steps": [
            {"type": "click", "selector": "#login-link"},
            {"type": "wait", "selector": "#username", "timeout": 5},
            {"type": "input", "selector": "id=username", "value": "admin"},
            {"type": "input", "selector": "id=password", "value": "123456"},
            {"type": "click", "selector": "#login-btn"},
            {"type": "wait", "selector": "#welcome-msg", "timeout": 5}
        ],
        "expected_type": "text",
        "expected_value": "admin",
        "priority": "P0",
        "description": "【业务】演示多步骤工作流 | 【技术】包含click/input/wait步骤组合"
    },
    {
        "id": "WF002",
        "name": "工作流-Cookie注入+导航",
        "type": "workflow",
        "url": "${base_url}/",
        "steps": [
            {"type": "cookie", "name": "test_cookie", "value": "workflow_test", "domain": "localhost"},
            {"type": "wait_page", "timeout": 5},
            {"type": "click", "selector": "#login-link"},
            {"type": "wait", "selector": "#username", "timeout": 5}
        ],
        "expected_type": "url",
        "expected_value": "/login",
        "priority": "P1",
        "description": "【业务】演示Cookie注入和工作流 | 【技术】包含cookie/wait_page步骤"
    },
    {
        "id": "WF003",
        "name": "工作流-搜索后验证结果",
        "type": "workflow",
        "url": "${base_url}/",
        "steps": [
            {"type": "input", "selector": "#search-input", "value": "playwright"},
            {"type": "click", "selector": "#search-btn"},
            {"type": "wait", "selector": "#search-results", "timeout": 5}
        ],
        "expected_type": "text",
        "expected_value": "搜索结果",
        "priority": "P0",
        "description": "【业务】验证搜索完整流程 | 【技术】演示输入+点击+等待的组合操作"
    },
    {
        "id": "WF004",
        "name": "工作流-多页面导航测试",
        "type": "workflow",
        "url": "${base_url}/",
        "steps": [
            {"type": "click", "selector": "#elements-link"},
            {"type": "wait_page", "timeout": 5},
            {"type": "input", "selector": "#username", "value": "navigation_test"},
            {"type": "click", "selector": "#back-home"},
            {"type": "wait_page", "timeout": 5}
        ],
        "expected_type": "url",
        "expected_value": "/",
        "priority": "P1",
        "description": "【业务】验证多页面导航往返 | 【技术】演示跨页面操作和返回验证"
    },
    {
        "id": "WF005",
        "name": "工作流-登录失败重试流程",
        "type": "workflow",
        "url": "${base_url}/login",
        "steps": [
            {"type": "input", "selector": "#username", "value": "admin"},
            {"type": "input", "selector": "#password", "value": "wrong_password"},
            {"type": "click", "selector": "#login-btn"},
            {"type": "wait", "selector": "#error-msg", "timeout": 5},
            {"type": "input", "selector": "#password", "value": "123456"},
            {"type": "click", "selector": "#login-btn"},
            {"type": "wait", "selector": "#welcome-msg", "timeout": 5}
        ],
        "expected_type": "text",
        "expected_value": "admin",
        "priority": "P0",
        "description": "【业务】验证登录失败后重试成功 | 【技术】演示错误处理和重试逻辑"
    },
    {
        "id": "WF006",
        "name": "工作流-元素定位综合练习",
        "type": "workflow",
        "url": "${base_url}/elements",
        "steps": [
            {"type": "input", "selector": "#username", "value": "id_test"},
            {"type": "input", "selector": "[name='email']", "value": "name_test@test.com"},
            {"type": "input", "selector": ".password-field", "value": "class_test"},
            {"type": "click", "selector": "#submit-btn"}
        ],
        "expected_type": "text",
        "expected_value": "成功",
        "priority": "P0",
        "description": "【业务】验证多种定位方式组合使用 | 【技术】演示ID/Name/Class混合定位"
    }
]
